# ---------- mode declarations ----------
:: default
:: leader     @
:: apps       @
:: apps_j     @   # apps -> j (JetBrains) -> ...

# ---------- enter / exit leader ----------
default < ctrl - space ; leader
leader  < escape       ; default

# ---------- leader: pick a group ----------
leader < a ; apps

# ---------- apps ----------
# unique letters run directly, colliding letters open a sub-group
apps < j ; apps_j
apps < b : open -a "Bruno"; skhd -k "escape"
apps < c : open -a "Google Chrome"; skhd -k "escape"
apps < f : open -a "Firefox"; skhd -k "escape"
apps < d : open -a "DBeaver"; skhd -k "escape"
apps < g : open -a "Ghostty"; skhd -k "escape"
apps < o : open -a "Obsidian"; skhd -k "escape"
apps < escape    ; default

# apps -> j : JetBrains

{{- if eq .device_type "personal" }}
apps_j < i : open -a "IntelliJ IDEA Community Edition"; skhd -k "escape"
{{- else if eq .device_type "work" }}
apps_j < i : open -a "IntelliJ IDEA"; skhd -k "escape"
{{ end }}

apps_j < w : open -a "WebStorm"; skhd -k "escape"
apps_j < escape    ; default

{{- if eq .device_type "work" }}
.load "work.skhdrc"
{{ end }}
